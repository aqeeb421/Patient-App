<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.VideoCallActivity">


    <FrameLayout
        android:id="@+id/calling_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/subscriber_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/publisher_container"
            android:layout_width="90dp"
            android:layout_height="120dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="#FFFFFF"
            android:padding="2dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:gravity="bottom|center"
        android:orientation="horizontal"
        android:visibility="visible">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/camera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:layout_marginTop="50dp"
            android:elevation="4dp"
            android:src="@drawable/ic_baseline_flip_camera_android_24"
            app:civ_border_color="@color/greylite"
            app:civ_border_width="10dp"
            app:civ_circle_background_color="@color/greylite" />


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/mute_voice"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:layout_marginTop="50dp"
            android:elevation="4dp"
            android:src="@drawable/ic_baseline_mic_off_24"
            app:civ_border_color="@color/greylite"
            app:civ_border_width="10dp"
            app:civ_circle_background_color="@color/greylite" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/mute_video"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:layout_marginTop="50dp"
            android:elevation="4dp"
            android:src="@drawable/ic_baseline_videocam_off_24"
            app:civ_border_color="@color/greylite"
            app:civ_border_width="10dp"
            app:civ_circle_background_color="@color/greylite" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/end_call"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:layout_marginTop="50dp"
            android:elevation="4dp"
            android:src="@drawable/ic_baseline_call_end_24"
            app:civ_border_color="@color/greylite"
            app:civ_border_width="10dp"
            app:civ_circle_background_color="@color/greylite" />

    </LinearLayout>


</RelativeLayout>